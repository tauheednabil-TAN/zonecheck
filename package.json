{
  "name": "zonecheck",
  "version": "0.1.0",
  "private": true,
  "description": "Which Copenhagen fare zone am I in? Derived from open data, not an official source.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:build": "tsx scripts/build-zones.ts",
    "data:refresh": "tsx scripts/build-zones.ts --diff"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "d3-delaunay": "^6.0.4",
    "maplibre-gl": "^4.7.1",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
